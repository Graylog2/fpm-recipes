#!/bin/sh

set -e

stopping="false"

case "$1" in
	# DEB based systems
	remove)
		stopping="true"
		if [ -f /etc/apparmor.d/graylog-headless-shell ]; then
                command -v apparmor_parser >/dev/null 2>&1 && apparmor_parser -R /etc/apparmor.d/graylog-headless-shell || true
                rm -f /etc/apparmor.d/graylog-headless-shell
        fi
		;;
	upgrade)
		stopping="false"
		;;
	deconfigure|failed-upgrade)
		;;
	# RPM based systems
	0)
		# Removal
		stopping="true"
		;;
	1)
		# Upgrade
		stopping="false"
		;;
	*)
		echo "[ERROR] pre-uninstall script called with unknown argument: '$1'"
		exit 1
		;;
esac

# Cleanup old upstart files to avoid the following warning on update:
#   dpkg: warning: unable to delete old directory '/etc/init': Directory not empty
rm -f /etc/init/graylog-server.conf /etc/init/graylog-server.override

if [ "$stopping" = "false" ]; then
	# Nothing to stop, exit early.
	exit 0
fi

systemctl --no-reload stop graylog-server.service >/dev/null 2>&1 || true
systemctl disable graylog-server>/dev/null 2>&1 || true

exit 0
