#!/bin/sh

set -e

user="graylog"
group="graylog"
datadir="/var/lib/graylog-server"
logdir="/var/log/graylog-server"
apparmor_profile="/etc/apparmor.d/graylog-headless-shell"

remove_data="false"
remove_apparmor="false"

case "$1" in
	# DEB based systems
	remove)
		remove_data="false"
		remove_apparmor="true"
		;;

	purge)
		remove_data="true"
		remove_apparmor="true"
		;;

	upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
		# Nothing to do here
		;;
	# RPM based systems
	0)
		# Removal
		# We don't remove any data on package removal to ensure that
		# uses don't lose any journal data when moving from the
		# graylog-server to the graylog-enterprise package.
		remove_data="false"
		;;
	1)
		# Upgrade
		remove_data="false"
		;;
	*)
		echo "[ERROR] post-uninstall script called with unknown argument: '$1'"
		exit 1
		;;
esac

if [ "$remove_apparmor" = "true" ] && [ -f "$apparmor_profile" ]; then
	if command -v apparmor_parser >/dev/null 2>&1; then
		apparmor_parser -R "$apparmor_profile" || true
	fi
	rm -f "$apparmor_profile"
fi

if [ "$remove_data" = "true" ]; then
	rm -rf "$datadir" "$logdir"
	rm -f /etc/graylog/server/node-id

	if id "$user" > /dev/null 2>&1 ; then
		userdel "$user" || true
	fi

	if getent group "$group" > /dev/null 2>&1 ; then
		groupdel "$group" || true
	fi
fi

exit 0
